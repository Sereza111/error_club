# Keep the public repository limited to the shipping site and portable source tools.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/DEPLOY.md
!/site-manifest.json
!/index.html
!/*.css
!/*.js
!/artists/
!/assets/
!/tools/
!/ops/
/assets/*
!/assets/favicon.svg
!/assets/grain.svg
!/assets/artists/
!/assets/audio-analysis/
!/assets/field/
/assets/field/*
!/assets/field/black-hole-v28-720p.mp4
!/assets/field/black-hole-v28-mobile.mp4
!/assets/field/black-hole-v28-poster.webp
/tools/*
!/tools/prepare_emohead_art.py
!/tools/prepare_waveform.py
!/tools/check_site.py
!/tools/test_player.cjs
!/tools/test_publisher.py
**/__pycache__/
**/.env*
**/*.pem
**/*.key
